{
  "rewrites": [
    {
      "source": "/api/kopis/:path*",
      "destination": "http://www.kopis.or.kr/:path*"
    },
    {
      "source": "/kopis-api/:path*",
      "destination": "http://www.kopis.or.kr/openApi/restful/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
